# Обязательные ключи
MISTRAL_API_KEY=replace_me
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=replace_me

# Необязательные настройки (показаны значения по умолчанию)
# MISTRAL_CHAT_MODEL=mistral-small-2506
# MISTRAL_EMBED_MODEL=mistral-embed
# QDRANT_COLLECTION=support_tickets
# RETRIEVAL_TOP_K=20
# MAX_SYNTH_STEPS=8
# REQUEST_RETRIES=4

# Пути к данным
# DATASET_PATH=data/customer_support_tickets_200k.csv
# SAMPLE_PATH=data/sample_10k.csv
# EMBEDDINGS_PATH=data/embeddings.npy
# SAMPLE_SIZE=10000

# Шрифт для PDF. По умолчанию подбирается системный TTF с кириллицей.
# REPORT_FONT_REGULAR=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# REPORT_FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# Куда класть PDF из веб-интерфейса (по умолчанию - временный каталог ОС)
# REPORT_DIR=
